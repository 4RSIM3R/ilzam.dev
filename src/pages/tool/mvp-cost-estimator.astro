---
import ContentLayout from '@/layouts/content-layout.astro'
import { MvpCostEstimator } from '@/components/mvp-cost-estimator'
---

<ContentLayout
	title="MVP Cost and Timeline Estimator | ilzam.dev"
	description="Pick the features your MVP needs and get a price range, week-by-week timeline, and recommended stack instantly. Download a one-page scope doc."
>
	<h1 class="text-3xl font-light leading-tight tracking-tight md:text-4xl print:hidden">
		MVP Cost and Timeline Estimator
	</h1>
	<p class="mt-3 text-muted-foreground print:hidden">
		Check the features you need. The estimate, timeline, and recommended
		stack update as you go, no signup required.
	</p>

	<div class="mt-8">
		<MvpCostEstimator client:load />
	</div>
</ContentLayout>
