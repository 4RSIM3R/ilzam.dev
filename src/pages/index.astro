---
import LandingLayout from '@/layouts/landing-layout.astro'
import { CapabilitiesSection } from '@/components/sections/capabilities'
import { ProcessSection } from '@/components/sections/process'
import { CaseStudiesSection } from '@/components/sections/case-studies'
import { TestimonialsSection } from '@/components/sections/testimonials'
import { ToolstackSection } from '@/components/sections/toolstack'
import { PricingSection } from '@/components/sections/pricing'
import { FaqSection, faqs } from '@/components/sections/faq'
import { CtaSection } from '@/components/sections/cta'
import { Badge } from '@/components/ui/badge'
import NoteCard from '@/components/note-card.astro'
import { NOTES_PATH, notesByDate } from '@/lib/notes'

// The homepage is in English, so it only features English notes.
const latestNotes = notesByDate().filter((note) => (note.lang ?? 'en') === 'en').slice(0, 3)

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"name": "Muhammad Ilzam Mulkhaq",
	"jobTitle": "AI-Native Software Engineer",
	"url": "https://ilzam.dev",
	"sameAs": [
		"https://github.com/4RSIM3R/",
		"https://www.linkedin.com/in/ilzam-mulkhaq/"
	],
	"knowsAbout": ["Go", "React", "TypeScript", ".NET", "PostgreSQL", "AWS", "AI/ML", "RAG Pipelines", "UI/UX Design"],
	"address": {
		"@type": "PostalAddress",
		"addressLocality": "Pasuruan",
		"addressRegion": "East Java",
		"addressCountry": "ID"
	}
}

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqs.map((faq) => ({
		"@type": "Question",
		"name": faq.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": faq.answer
		}
	}))
}
---

<LandingLayout>
	<h1 class="sr-only">Muhammad Ilzam Mulkhaq, AI-Native Software Engineer for Early-Stage Founders</h1>
	<CapabilitiesSection client:load />
	<ProcessSection client:load />
	<CaseStudiesSection client:load />
	<TestimonialsSection />
	<ToolstackSection client:load />
	<PricingSection client:load />
	<FaqSection client:load />
	<section id="notes" class="snap-start px-6 py-12 md:px-10 md:py-16">
		<Badge
			variant="outline"
			className="mb-6 rounded-none border-0 font-mono text-xs uppercase tracking-widest"
		>
			[ Notes ]
		</Badge>
		<div class="flex flex-wrap items-end justify-between gap-4">
			<h2 class="text-4xl font-light leading-tight tracking-tight md:text-5xl">
				Latest <span class="rounded-sm bg-amber-100 px-1 font-normal">Notes</span>
			</h2>
			<a href={NOTES_PATH} class="text-sm text-muted-foreground underline underline-offset-4 transition-colors hover:text-foreground">
				All notes
			</a>
		</div>
		<div class="mt-8 grid gap-4 md:grid-cols-3">
			{latestNotes.map((note) => <NoteCard note={note} clamp />)}
		</div>
	</section>
	<CtaSection client:load />
	<footer class="border-t px-6 py-8 md:px-10">
		<div class="flex flex-col gap-4 text-sm md:flex-row md:items-center md:justify-between">
			<p class="text-muted-foreground">Building from East Java. Shipping to the world.</p>
			<nav class="flex flex-wrap gap-x-6 gap-y-2">
				<a href="/work/" class="text-muted-foreground underline underline-offset-4 transition-colors hover:text-foreground">Work</a>
				<a href="/notes/" class="text-muted-foreground underline underline-offset-4 transition-colors hover:text-foreground">Notes</a>
				<a href="/pricing/" class="text-muted-foreground underline underline-offset-4 transition-colors hover:text-foreground">Pricing</a>
				<a href="/contact/" class="text-muted-foreground underline underline-offset-4 transition-colors hover:text-foreground">Contact</a>
				<a href="/tool/" class="text-muted-foreground underline underline-offset-4 transition-colors hover:text-foreground">Tools</a>
				<a href="/kawakib/" class="text-muted-foreground underline underline-offset-4 transition-colors hover:text-foreground">Kawakib</a>
				<a href="https://github.com/4RSIM3R/" target="_blank" rel="noopener noreferrer" class="text-muted-foreground underline underline-offset-4 transition-colors hover:text-foreground">GitHub</a>
				<a href="https://www.linkedin.com/in/ilzam-mulkhaq/" target="_blank" rel="noopener noreferrer" class="text-muted-foreground underline underline-offset-4 transition-colors hover:text-foreground">LinkedIn</a>
			</nav>
		</div>
	</footer>
	<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</LandingLayout>
