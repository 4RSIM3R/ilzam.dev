---
import '@/styles/global.css'
import { LandingNav } from '@/components/landing-nav'

interface Props {
	title?: string
	description?: string
	canonicalUrl?: string
	ogImage?: string
}

const {
	title = 'Muhammad Ilzam Mulkhaq | AI-Native Software Engineer for Founders',
	description = 'Two AI agents and one senior engineer, and you only pay for the engineer. AI-native software engineer for early-stage founders: MVP and product builds, vibe-code rescue, and a senior engineer on retainer. Based in Indonesia, working globally.',
	canonicalUrl = Astro.url.href,
	ogImage = '/wave.png',
} = Astro.props

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://ilzam.dev'
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Ilzam" />
		<link rel="canonical" href={canonicalUrl} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:site_name" content="ilzam.dev" />
		<meta property="og:locale" content="en_US" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<!-- Google Tag Manager -->
		<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
		new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
		j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
		'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
		})(window,document,'script','dataLayer','GTM-PSXJG2TM');</script>

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-3VSD62FKPG" is:inline></script>
		<script is:inline>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());
		gtag('config', 'G-3VSD62FKPG');
		</script>

		<!-- Datafast -->
		<script
			is:inline
			defer
			data-website-id="dfid_8NlJpLEFGgOq9FzoCeI2u"
			data-domain="ilzam.dev"
			src="https://datafa.st/js/script.js"></script>
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PSXJG2TM"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<LandingNav client:load />
		<!-- clip, not hidden: scenes start off to the side without widening the page, and sticky still works. -->
		<main class="overflow-x-clip">
			<slot />
		</main>
		<script>
			import Lenis from 'lenis'

			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
			// Smooth wheel scrolling turns the page into one continuous journey. Touch keeps native scrolling.
			const lenis = reduceMotion ? null : new Lenis({ autoRaf: true })

			// Sections set scroll-margin-top, which both Lenis and native scrolling respect.
			function scrollToTarget(hash: string) {
				const target = hash === '#top' ? document.body : document.querySelector<HTMLElement>(hash)
				if (!target) return
				if (lenis) lenis.scrollTo(hash === '#top' ? 0 : target)
				else target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth' })
				history.replaceState(null, '', hash === '#top' ? location.pathname : hash)
			}

			document.addEventListener('click', (event) => {
				const link = (event.target as Element).closest?.('a[href^="#"]')
				const hash = link?.getAttribute('href')
				if (!hash || hash === '#' || event.defaultPrevented) return
				event.preventDefault()
				scrollToTarget(hash)
			})

			window.addEventListener('journey:scroll-to', (event) => {
				scrollToTarget((event as CustomEvent<string>).detail)
			})
		</script>
	</body>
</html>
